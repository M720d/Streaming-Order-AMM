# Template for Hardhat environment variables.

# To use this template, copy this file, rename it .env, and fill in the values.

# If not set, we provide default values (check `hardhat.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this .env file you can use: process.env.VARIABLENAME
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Don't fill this value manually, run yarn generate to generate a new account or yarn account:import to import an existing PK.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# --- Off-chain bots (scripts/keeper.ts, scripts/arb.ts). Use TESTNET-ONLY accounts, never a wallet with real funds. ---
RPC_URL=
ORDER_BOOK=
POOL=
BTC_USD_FEED=
# Account that sends executeSlice (needs a little ETH for gas; holds no tokens).
KEEPER_PRIVATE_KEY=
# Account that arbitrages the pool (needs ETH for gas plus WBTC and USDC).
ARB_PRIVATE_KEY=

# Keeper options (defaults shown)
# START_BLOCK=0              # set to the OrderBook deployment block on a live network
# POLL_INTERVAL_SEC=15
# RETRY_DELAY_SEC=30         # wait before re-checking an order whose last attempt was refused or failed
# TX_TIMEOUT_SEC=120
# CONFIRMATIONS=1
# MAX_LOG_RANGE=500          # lower this if your RPC limits eth_getLogs ranges
# SEND_SKIPS=false           # true: also send guard skips so SliceSkipped is recorded on chain

# Arbitrage bot options (defaults shown)
# ARB_GAP_THRESHOLD_BPS=100
# ARB_MAX_TRADE_WBTC=5
# ARB_MAX_TRADE_USDC=300000
# ARB_MIN_PROFIT_USDC=1
# ARB_SLIPPAGE_BPS=50
# ARB_ORACLE_MAX_AGE_SEC=3600
# ARB_POLL_INTERVAL_SEC=15
